# Library Print Project Configuration
# Pass these values in your Vercel Project Settings (Environment Variables)

# Convex Configuration
VITE_CONVEX_URL=https://avid-lark-265.convex.cloud
VITE_CONVEX_SITE_URL=https://avid-lark-265.convex.site
CONVEX_DEPLOYMENT=dev:avid-lark-265
# Set this in Vercel secrets; do not commit to source control:
# CONVEX_API_KEY=dev:avid-lark-265|your-dev-key-here

# 📞 The phone number displayed to students for coordination
VITE_CAPSTONE_SHOP_MOBILE=9762626246

# 💰 Extra service fee for project handling (e.g. 50)
VITE_CAPSTONE_PROJECT_SERVICE_FEE=0

# 🎓 List of allowed colleges (Optional, comma-separated)
VITE_CAPSTONE_COLLEGE_LIST=RIT Library

# ⚙️ Feature flag to enable/disable the portal (true/false)
VITE_CAPSTONE_FEATURE_ENABLED=true

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional server-side environment variables for API routes
# SUPABASE_URL=your-supabase-url
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Key (if used)
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id-here
